{
  "name": "idphoto-app",
  "productName": "证件照工具",
  "version": "1.0.0",
  "private": true,
  "description": "证件照工具：换底色（含自定义颜色）+ 标准规格裁剪 + 精确像素导出，全程本地处理",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win -c.electronDist=node_modules/electron/dist",
    "dist:linux": "electron-builder --linux --publish never",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "devDependencies": {
    "electron": "38.8.6",
    "electron-builder": "26.15.3"
  }
}
